{
  "cleanupPeriodDays": 3650,
  "env": {
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "mcp__ccd_session__*",
      "mcp__ccd_session_mgmt__*",
      "mcp__ccd_settings__*",
      "mcp__ccd_connectors__*",
      "mcp__ccd_directory__*",
      "mcp__ccd_host__*",
      "mcp__ccd_pr__*",
      "mcp__ccd_sidebar__*",
      "mcp__ccd_turn__*",
      "mcp__ccd_view__*",
      "mcp__ccd_window__*"
    ]
  },
  "skillOverrides": {
    "batch": "user-invocable-only",
    "code-review": "user-invocable-only",
    "security-review": "user-invocable-only",
    "loop": "user-invocable-only",
    "verify": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "update-config": "user-invocable-only",
    "anthropic-skills:setup-cowork": "user-invocable-only",
    "anthropic-skills:consolidate-memory": "user-invocable-only",
    "anthropic-skills:explain-usage": "user-invocable-only"
  },
  "worktree": {
    "baseRef": "head"
  },
  "disableRemoteControl": true,
  "enableWorkflows": false,
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "viewMode": "verbose",
  "skipWebFetchPreflight": true,
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "notifications_disabled",
  "terminalProgressBarEnabled": false,
  "crossSessionInbound": "refuse",
  "inputNeededNotifEnabled": false,
  "precomputeCompactionEnabled": false,
  "feedbackSurveyRate": 0,
  "switchModelsOnFlag": false
}
