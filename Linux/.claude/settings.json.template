{
  "cleanupPeriodDays": 3650,
  "env": {
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "mcp__ccd_session",
      "mcp__ccd_session_mgmt",
      "mcp__ccd_settings",
      "mcp__ccd_connectors",
      "mcp__ccd_directory",
      "mcp__ccd_host",
      "mcp__ccd_pr",
      "mcp__ccd_sidebar",
      "mcp__ccd_turn",
      "mcp__ccd_view",
      "mcp__ccd_window"
    ]
  },
  "skillOverrides": {
    "batch": "user-invocable-only",
    "code-review": "user-invocable-only",
    "security-review": "user-invocable-only",
    "loop": "user-invocable-only",
    "verify": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "update-config": "user-invocable-only",
    "setup-cowork": "user-invocable-only",
    "consolidate-memory": "user-invocable-only",
    "explain-usage": "user-invocable-only"
  },
  "worktree": {
    "baseRef": "head"
  },
  "disableRemoteControl": true,
  "enableWorkflows": false,
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "viewMode": "verbose",
  "skipWebFetchPreflight": true,
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "notifications_disabled",
  "terminalProgressBarEnabled": false,
  "crossSessionInbound": "refuse",
  "inputNeededNotifEnabled": false,
  "precomputeCompactionEnabled": false,
  "feedbackSurveyRate": 0,
  "switchModelsOnFlag": false
}
