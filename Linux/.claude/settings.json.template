{
  "cleanupPeriodDays": 3650,
  "env": {
    "BASH_MAX_TIMEOUT_MS": "240000",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_FEEDBACK_COMMAND": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skillOverrides": {
    "batch": "user-invocable-only",
    "code-review": "user-invocable-only",
    "security-review": "user-invocable-only",
    "loop": "user-invocable-only",
    "verify": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "update-config": "user-invocable-only",
    "anthropic-skills:setup-cowork": "user-invocable-only",
    "anthropic-skills:consolidate-memory": "user-invocable-only",
    "anthropic-skills:explain-usage": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/prefer-uv.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/no-destructive-git.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/no-dangerous-ops.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "disableRemoteControl": true,
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "academic-research-skills": {
      "source": {
        "source": "github",
        "repo": "Imbad0202/academic-research-skills"
      }
    }
  },
  "outputStyle": "Explanatory",
  "viewMode": "verbose",
  "skipWebFetchPreflight": true,
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "notifications_disabled",
  "autoScrollEnabled": true,
  "terminalProgressBarEnabled": false,
  "remoteControlAtStartup": false,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": false,
  "autoConnectIde": false
}
